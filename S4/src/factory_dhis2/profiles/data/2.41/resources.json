    },
    {
      "logicalName": "tracker.trackedEntities.get",
      "path": "tracker/trackedEntities",
      "method": "GET",
      "parameters": { "trackedEntity": "trackedEntity", "orgUnits": "orgUnits", "attribute": "attribute" },
      "paging": "token",
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.enrollments",
      "path": "tracker/enrollments",
      "method": "POST",
      "parameters": { "importMode": "importMode" },
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.enrollments.get",
      "path": "tracker/enrollments",
      "method": "GET",
      "parameters": { "program": "program", "orgUnits": "orgUnits", "enrollment": "enrollment" },
      "paging": "token",
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.events",
      "path": "tracker/events",
      "method": "POST",
      "parameters": { "importMode": "importMode" },
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.events.get",
      "path": "tracker/events",
      "method": "GET",
      "parameters": { "program": "program", "orgUnits": "orgUnits", "pageSize": "pageSize" },
      "paging": "token",
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.relationships",
      "path": "tracker/relationships",
      "method": "POST",
      "parameters": { "importMode": "importMode" },
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
