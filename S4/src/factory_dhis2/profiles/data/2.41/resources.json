      "credentialScope": "discovery"
    },
    {
      "logicalName": "programIndicators.expression.validate",
      "path": "programIndicators/expression/validate",
      "method": "GET",
      "parameters": { "expression": "expression", "programId": "programId" },
      "credentialScope": "discovery"
    },
    {
      "logicalName": "validationRules.expression.validate",
      "path": "validationRules/expression/validate",
      "method": "GET",
      "parameters": {
        "expression": "expression",
        "categoryComboId": "categoryComboId"
      },
      "credentialScope": "discovery"
    },
    {
      "logicalName": "dataValues.query",
      "path": "dataValues",
      "method": "GET",
      "parameters": { "dataElement": "de", "period": "pe", "orgUnit": "ou", "pageSize": "pageSize" },
      "paging": "pager",
      "credentialScope": "discovery"
    },
    {
      "logicalName": "tracker.import",
      "path": "tracker",
      "method": "POST",
      "parameters": {
        "importMode": "importMode",
        "importerVersion": "importerVersion",
        "atomicMode": "atomicMode",
        "async": "async",
        "lastUpdatedMode": "lastUpdatedMode"
      },
      "paging": "none",
      "trackerApi": true,
      "credentialScope": "tracker"
    },
    {
      "logicalName": "tracker.trackedEntities",
