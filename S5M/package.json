{
  "name": "@damf/factory-mobile",
  "private": true,
  "version": "1.14.1",
  "type": "module",
  "description": "S5-M Factory Mobile Web — a mobile-first, desktop-compatible H5/PWA front-end for the DAMF Metadata Factory. Talks to the S1 public REST API (/api/v1) and its SSE stream exclusively.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:harness": "VITE_DEV_HARNESS=1 vite build --outDir dist-e2e",
    "preview": "vite preview",
    "codegen": "openapi-typescript ./contract/openapi.json -o ./src/api/generated/schema.d.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:harness && playwright test",
    "check:budget": "node ./scripts/check-bundle-budget.mjs",
    "report:fui": "node ./scripts/report-fui.mjs",
    "report:graph": "playwright test graph.perf",
    "report:lighthouse": "npm run build && node ./scripts/lighthouse.mjs",
    "verify:live": "node ./scripts/verify-live.mjs",
    "verify": "npm run codegen && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:budget",
    "report:e2e": "playwright test",
    "report:ac": "node ./scripts/report-ac-matrix.mjs",
    "verify:all": "npm run verify && npm run test:e2e && npm run report:ac",
    "test:budget": "npm run build:harness && playwright test clickBudget --project=mobile-mid --project=desktop",
    "test:capabilities": "npm run build:harness && playwright test graph.perf jsonEditor --project=mobile-mid --project=desktop",
    "test:acceptance": "npm run build:harness && playwright test clickBudget notGenerated m4Presence i18n --project=mobile-mid --project=desktop"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@tanstack/vue-query": "^5.62.16",
    "@vueuse/core": "^12.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dayjs": "^1.11.13",
    "js-yaml": "^5.4.2",
    "jsonc-parser": "^3.3.1",
    "pinia": "^2.3.1",
    "vant": "^4.9.14",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.14.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
