# Build-time conveniences only. In production the S1 base URL comes from the runtime
# config.js (window.__FACTORY_CONFIG__), NOT from these, so the same image stays portable.

# Vite dev-server proxy target for /api/v1 (a real S1). Default http://127.0.0.1:8000.
VITE_S1_PROXY=http://127.0.0.1:8000

# Optional build-time S1 base URL; runtime config.js overrides this. Empty => same-origin.
# VITE_API_BASE_URL=

# Optional build-time API path prefix. Default /api/v1.
# VITE_API_PATH_PREFIX=/api/v1

# Turn on the PWA service worker + manifest at build time.
VITE_ENABLE_PWA=1
