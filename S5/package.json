{
  "name": "@damf/factory-ui",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "description": "S5 Factory UI — the only user-facing console for the DAMF Metadata Factory. Talks to S1 public REST API (/api/v1) and SSE exclusively.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MOCK=1 vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:e2e": "VITE_ENABLE_MOCK=1 vite build --outDir dist-e2e",
    "preview": "vite preview",
    "codegen": "npm run codegen:types && npm run codegen:zod",
    "codegen:types": "openapi-typescript ./contract/openapi.json -o ./src/api/generated/schema.d.ts",
    "codegen:zod": "tsx ./scripts/codegen-zod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "a11y": "playwright test --project=a11y",
    "check:budget": "node ./scripts/check-bundle-budget.mjs",
    "verify": "npm run codegen && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:budget"
  },
  "dependencies": {
    "@dhis2/app-runtime": "^3.17.4",
    "@dhis2/d2-i18n": "^1.1.0",
    "@dhis2/ui": "^10.19.0",
    "@hookform/resolvers": "^3.9.1",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.59.16",
    "@xyflow/react": "^12.3.5",
    "i18next": "^23.16.4",
    "js-yaml": "^4.3.2",
    "monaco-editor": "^0.52.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^6.28.0",
    "styled-jsx": "^4.0.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.10.2",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "json-schema-to-zod": "^2.6.0",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
