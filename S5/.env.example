# Build-time conveniences only. In production the S1 base URL comes from the runtime config.js
# file (UI-APP-005), NOT from these, so the same image stays portable.

# Vite dev-server proxy target for /api/v1 when NOT using the mock (a real S1).
VITE_S1_PROXY=http://localhost:8000

# Turn on the in-browser MSW mock layer for standalone development (UI-NFR-05).
# VITE_ENABLE_MOCK=1

# Optional build-time S1 base URL; runtime config.js overrides this.
# VITE_API_BASE_URL=
