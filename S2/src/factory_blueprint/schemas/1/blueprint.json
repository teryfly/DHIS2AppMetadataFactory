{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damf.invalid/bp/1/blueprint.json",
  "title": "App Blueprint",
  "description": "Root Blueprint schema, version 1 (BP-SCH-001). Every section is required: an empty section is an explicit empty collection, never an absent one, so Patch validation and Diff always have a baseline (BP-DRF-005.2). Each section is addressed by the standalone schema id that get_section_schema() produces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprintSchemaVersion",
    "project",
    "requirements",
    "domain",
    "useCases",
    "actors",
    "organizationModel",
    "accessModel",
    "architecture",
    "mapping",
    "registry",
    "pages",
    "apiIntents",
    "uiIntents",
    "rules",
    "fixtures",
    "environmentConstraints",
    "generationPolicy"
  ],
  "properties": {
    "blueprintSchemaVersion": { "type": "integer", "const": 1 },
    "project": { "$ref": "https://damf.invalid/bp/1/sections/project.json" },
    "requirements": { "$ref": "https://damf.invalid/bp/1/sections/requirements.json" },
    "domain": { "$ref": "https://damf.invalid/bp/1/sections/domain.json" },
    "useCases": { "$ref": "https://damf.invalid/bp/1/sections/useCases.json" },
    "actors": { "$ref": "https://damf.invalid/bp/1/sections/actors.json" },
    "organizationModel": { "$ref": "https://damf.invalid/bp/1/sections/organizationModel.json" },
    "accessModel": { "$ref": "https://damf.invalid/bp/1/sections/accessModel.json" },
    "architecture": { "$ref": "https://damf.invalid/bp/1/sections/architecture.json" },
    "mapping": { "$ref": "https://damf.invalid/bp/1/sections/mapping.json" },
    "registry": { "$ref": "https://damf.invalid/bp/1/sections/registry.json" },
    "pages": { "$ref": "https://damf.invalid/bp/1/sections/pages.json" },
    "apiIntents": { "$ref": "https://damf.invalid/bp/1/sections/apiIntents.json" },
    "uiIntents": { "$ref": "https://damf.invalid/bp/1/sections/uiIntents.json" },
    "rules": { "$ref": "https://damf.invalid/bp/1/sections/rules.json" },
    "fixtures": { "$ref": "https://damf.invalid/bp/1/sections/fixtures.json" },
    "environmentConstraints": { "$ref": "https://damf.invalid/bp/1/sections/environmentConstraints.json" },
    "generationPolicy": { "$ref": "https://damf.invalid/bp/1/sections/generationPolicy.json" }
  }
}
